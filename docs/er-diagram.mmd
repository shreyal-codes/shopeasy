erDiagram
    USERS ||--o{ CART_ITEMS : "has"
    USERS ||--o{ ORDERS : "places"
    CATEGORIES ||--o{ PRODUCTS : "contains"
    PRODUCTS ||--o{ CART_ITEMS : "added to"
    ORDERS ||--|{ ORDER_ITEMS : "includes"
    PRODUCTS ||--o{ ORDER_ITEMS : "sold as"

    USERS {
        int id PK
        text name
        text email UK
        text password_hash
        text role "customer or admin"
        text phone
        text address
        text created_at
    }
    CATEGORIES {
        int id PK
        text name UK
    }
    PRODUCTS {
        int id PK
        int category_id FK
        text name
        text description
        int price "in paise"
        int stock
        text image_url
        int is_active
        text created_at
    }
    CART_ITEMS {
        int id PK
        int user_id FK
        int product_id FK
        int quantity "UNIQUE user_id + product_id"
    }
    ORDERS {
        int id PK
        int user_id FK
        int total_amount
        text status "Placed Shipped Delivered Cancelled"
        text shipping_name
        text shipping_phone
        text shipping_address
        text payment_method
        text created_at
    }
    ORDER_ITEMS {
        int id PK
        int order_id FK
        int product_id FK
        int quantity
        int unit_price "price at order time"
    }
